WORKSIGHT_DATA_DIR=./data
TORCH_HOME=./data/torch
# auto selects an available CUDA/HIP GPU, otherwise CPU. MPS is opt-in.
WORKSIGHT_DEVICE=auto
# Set to 1 on the competition AMD deployment; refuses CPU/NVIDIA fallback.
WORKSIGHT_REQUIRE_AMD=0
WORKSIGHT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set on a remote deployment; frontend should call through its own server.
WORKSIGHT_API_KEY=
# Optional assistive inspection report via AMD Token Factory. Leave empty to disable.
# Images are sent to AMD's hosted endpoint only when a report is requested.
RADEON_API_KEY=
WORKSIGHT_REPORT_MODELS=Gemma-4-31B-IT,DeepSeek-V4.1-Flash
